#!/bin/sh
set -eu
grill_data="${XDG_DATA_HOME:-$HOME/.local/share}/grill-ui"
grill_root="${HERDR_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
# Before the first install there is no venv; reopen builds it with python3.
grill_python="$grill_data/venv/bin/python"
[ -x "$grill_python" ] || grill_python=python3
exec "$grill_python" "$grill_root/scripts/grill_herdr.py" reopen
